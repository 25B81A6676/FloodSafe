# ---------------------------------------------------------------------------
# FloodSafe configuration
#
# Every value below has a working default. The prototype runs with NO .env file
# at all, because none of the data sources it uses requires an API key.
# Copy to .env only if you want to override something.
# ---------------------------------------------------------------------------

# --- application ------------------------------------------------------------
APP_NAME=FloodSafe
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- pilot region -----------------------------------------------------------
# Must match the "id" of a file in data/regions/  (uttarakhand, himachal_pradesh)
DEFAULT_REGION_ID=uttarakhand

# --- storage ----------------------------------------------------------------
# DATABASE_PATH=./data/cache/floodsafe.db

# --- external data sources (all free, all keyless) --------------------------
# Override only to use a self-hosted mirror.
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
# OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# --- network behaviour ------------------------------------------------------
# HTTP_TIMEOUT_SECONDS=25
# HTTP_MAX_RETRIES=2

# --- cache lifetimes, seconds ----------------------------------------------
# CACHE_TTL_WEATHER=900          # 15 minutes
# CACHE_TTL_HYDROLOGY=10800      # 3 hours  (GloFAS updates daily)
# CACHE_TTL_OSM=604800           # 7 days   (OSM geometry changes slowly)
# CACHE_TTL_ELEVATION=15552000   # 180 days (terrain is static)

# --- startup ----------------------------------------------------------------
# Warm the cache in the background at boot so the first dashboard load is fast.
# STARTUP_PREFETCH=true

# --- frontend ---------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# NOTE: There are deliberately no API keys here. If a future data source needs
# one, add it to this file as an empty placeholder and read it via
# backend/app/config/settings.py. Never place credentials in frontend code.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Flood-alert push notifications (Firebase Cloud Messaging)
#
# ALL OPTIONAL. With none of these set FloodSafe starts normally, every other
# feature works, and /api/notifications/status reports "not configured" rather
# than pretending alerts are being delivered.
#
# Setup walkthrough: docs/NOTIFICATIONS.md
# NEVER commit real values. .env is already git-ignored.
# ---------------------------------------------------------------------------

# --- server side (SECRET) ---------------------------------------------------
# The service-account JSON downloaded from
#   Firebase console > Project settings > Service accounts > Generate new private key
# Give the PATH to that file (keep the file itself out of the repository):
# FCM_SERVICE_ACCOUNT_FILE=./secrets/floodsafe-service-account.json
#
# ...or paste the JSON itself, for hosts that only offer env vars:
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
#
# Optional: inferred from the service account when omitted.
# FCM_PROJECT_ID=your-firebase-project-id

# --- client side (PUBLIC by design) -----------------------------------------
# From Firebase console > Project settings > General > Your apps > Web app.
# These identify the project to the browser SDK and are visible in any web
# client; they are not secrets. They are served to the frontend at runtime by
# /api/notifications/config so changing project needs no rebuild.
# FIREBASE_WEB_API_KEY=AIzaSyEXAMPLE-replace-me
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_WEB_PROJECT_ID=your-firebase-project-id
# FIREBASE_MESSAGING_SENDER_ID=000000000000
# FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Web Push certificate key pair ("VAPID key"):
#   Project settings > Cloud Messaging > Web configuration
# FIREBASE_VAPID_KEY=BEXAMPLE-public-vapid-key-replace-me

# --- alerting behaviour -----------------------------------------------------
# SAFETY DEFAULT: true. Risk transitions are evaluated, targeted and recorded,
# but no real emergency push is sent. Test alerts still send. Set to false only
# when you actually intend real phones to be paged.
# FLOOD_ALERT_TEST_MODE=true
#
# Emergency alerts fire only on a transition INTO one of these levels.
# ALERT_TRIGGER_LEVELS=HIGH,EXTREME
#
# Suppression window for a repeat alert at the same location and severity.
# ALERT_COOLDOWN_MINUTES=30
#
# Which devices an alert reaches: location | district | state | radius
# ALERT_TARGETING_SCOPE=location
#
# Used for the notification's deep link.
# PUBLIC_DASHBOARD_URL=http://localhost:5173
