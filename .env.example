# ---------------------------------------------------------------------------
# FloodSafe configuration
#
# Every value below has a working default. The prototype runs with NO .env file
# at all, because none of the data sources it uses requires an API key.
# Copy to .env only if you want to override something.
# ---------------------------------------------------------------------------

# --- application ------------------------------------------------------------
APP_NAME=FloodSafe
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- pilot region -----------------------------------------------------------
# Must match the "id" of a file in data/regions/  (uttarakhand, himachal_pradesh)
DEFAULT_REGION_ID=uttarakhand

# --- storage ----------------------------------------------------------------
# DATABASE_PATH=./data/cache/floodsafe.db

# --- external data sources (all free, all keyless) --------------------------
# Override only to use a self-hosted mirror.
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
# OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# --- network behaviour ------------------------------------------------------
# HTTP_TIMEOUT_SECONDS=25
# HTTP_MAX_RETRIES=2

# --- cache lifetimes, seconds ----------------------------------------------
# CACHE_TTL_WEATHER=900          # 15 minutes
# CACHE_TTL_HYDROLOGY=10800      # 3 hours  (GloFAS updates daily)
# CACHE_TTL_OSM=604800           # 7 days   (OSM geometry changes slowly)
# CACHE_TTL_ELEVATION=15552000   # 180 days (terrain is static)

# --- startup ----------------------------------------------------------------
# Warm the cache in the background at boot so the first dashboard load is fast.
# STARTUP_PREFETCH=true

# --- frontend ---------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# NOTE: There are deliberately no API keys here. If a future data source needs
# one, add it to this file as an empty placeholder and read it via
# backend/app/config/settings.py. Never place credentials in frontend code.
# ---------------------------------------------------------------------------
